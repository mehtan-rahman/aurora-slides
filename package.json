{
  "name": "aurora-slides",
  "version": "0.2.0",
  "description": "Compile Beamer .tex decks into manim-style animated HTML presentations: written equations, animated plots, curly-arrow chemistry mechanisms.",
  "keywords": [
    "beamer",
    "latex",
    "slides",
    "presentation",
    "manim",
    "animation",
    "chemistry",
    "mechanism",
    "tikz",
    "html",
    "pdf",
    "overlays"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehtan-rahman/aurora-slides.git"
  },
  "homepage": "https://github.com/mehtan-rahman/aurora-slides#readme",
  "bugs": {
    "url": "https://github.com/mehtan-rahman/aurora-slides/issues"
  },
  "type": "module",
  "bin": {
    "aurora": "bin/aurora.js"
  },
  "files": [
    "bin",
    "dist",
    "runtime",
    "templates",
    "tex",
    "skills",
    "docs/REFERENCE.md",
    "AGENTS.md",
    "llms.txt",
    "docs/BEAMER.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "examples": "node src/cli.ts build examples/demo.tex -o docs/demo.html && node src/cli.ts build examples/tour/deck.tex -o docs/tour.html",
    "check": "npm run typecheck && npm test && node src/cli.ts check examples/demo.tex --strict && node src/cli.ts check examples/tour/deck.tex --strict",
    "prepublishOnly": "npm run check && npm run build",
    "docs": "node scripts/gen-docs.ts",
    "prepare": "tsc"
  },
  "dependencies": {
    "@rdkit/rdkit": "2024.3.5-1.0.0",
    "mathjax-full": "3.2.2"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
